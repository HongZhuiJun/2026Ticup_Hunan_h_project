 126:Core/Src/main.c ****     /* ===== K230 视觉接收联调观察（临时显示，接入控制环后可删）=====
 127:Core/Src/main.c ****        第 1 行：钢球在水管上的物理位置(cm)：右为正、左为负、0 为水管中�
 128:Core/Src/main.c ****                位置无效（钢球丢失或视觉离线）时显示 lost
 129:Core/Src/main.c ****        第 2 行：原始像素，px 固定不动说明没收到数据；
 130:Core/Src/main.c ****                px 有值但第 1 行是 lost 说明钢球丢失（current_x = -1）
 131:Core/Src/main.c ****        第 3 行：视觉链路在线状态（超过 200ms 没收到合法帧即离线）
 132:Core/Src/main.c ****        第 4 行：合法帧数 / 校验失败帧数，校验数持续增长说明协议或波特�
 133:Core/Src/main.c ****     uint32_t now_ms = HAL_GetTick();
 134:Core/Src/main.c ****     if ((k230_vision != NULL) &&
 135:Core/Src/main.c ****         ((uint32_t)(now_ms - k230_display_last_ms) >= K230_DEBUG_DISPLAY_PERIOD_MS)) {
 136:Core/Src/main.c ****         k230_display_last_ms = now_ms;
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****         /* 先清零：注册失败时 GetData() 会直接返回且不填结构体，
 139:Core/Src/main.c ****            此时下面仍会读 current_x_px，清零可避免读到未初始化内存 */
 140:Core/Src/main.c ****         K230_Data_s k230_data = {0};
 141:Core/Src/main.c ****         if (K230ToStm32GetData(k230_vision, &k230_data) != 0u) {
 142:Core/Src/main.c ****             /* 浮点拆成整数显示：newlib-nano 默认不带 %f 支持。
 143:Core/Src/main.c ****                符号必须单独取，不能借"整数部分的符号"：位置在 (-1,0) cm 时
 144:Core/Src/main.c ****                整数部分为 0，会丢掉负号把 -0.50 显示成 +00.50，
 145:Core/Src/main.c ****                而这恰好是控制目标附近的区间 */
 146:Core/Src/main.c ****             int32_t pos_cm_x100 = (int32_t)(k230_data.pos_cm * 100.0f);
