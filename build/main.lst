 147:Core/Src/main.c ****             uint32_t pos_magnitude = (pos_cm_x100 < 0) ? (uint32_t)(-pos_cm_x100)
 148:Core/Src/main.c ****                                                        : (uint32_t)pos_cm_x100;
 149:Core/Src/main.c ****             /* 坐标按 8px/字符排；符号 1 格 + 整数 2 格 + 小数点 1 格 + 小数 2 �
 150:Core/Src/main.c ****             OLED_ShowString(0, 0, "pos:", OLED_8X16);                        /* x   0..31  */
 151:Core/Src/main.c ****             OLED_ShowChar(32, 0, (pos_cm_x100 < 0) ? '-' : '+', OLED_8X16);  /* x  32..39  */
 152:Core/Src/main.c ****             OLED_ShowNum(40, 0, pos_magnitude / 100u, 2, OLED_8X16);         /* x  40..55  */
 153:Core/Src/main.c ****             OLED_ShowString(56, 0, ".", OLED_8X16);                          /* x  56..63  */
 154:Core/Src/main.c ****             OLED_ShowNum(64, 0, pos_magnitude % 100u, 2, OLED_8X16);         /* x  64..79  */
 155:Core/Src/main.c ****             OLED_ShowString(88, 0, "cm", OLED_8X16);                         /* x  88..103 */
 156:Core/Src/main.c ****         } else {
 157:Core/Src/main.c ****             /* 用空格补足 16 字符(128px)，盖掉上次显示残留的像素 */
