 168:Core/Src/main.c ****                     (unsigned long)(k230_stats.frame_count % 100000UL),
 169:Core/Src/main.c ****                     (unsigned long)(k230_stats.checksum_error_count % 1000UL));
 170:Core/Src/main.c **** 
 171:Core/Src/main.c ****         OLED_Update();
 172:Core/Src/main.c ****     }
 173:Core/Src/main.c ****   }
