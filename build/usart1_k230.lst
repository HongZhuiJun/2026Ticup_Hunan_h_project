  62:bsp/usart/usart1_k230.c **** /**
  63:bsp/usart/usart1_k230.c ****  * @brief 重新挂载 DMA 接收（仅 Normal 模式使用）。
  64:bsp/usart/usart1_k230.c ****  *
  65:bsp/usart/usart1_k230.c ****  * @note HAL 在调用 HAL_UARTEx_RxEventCallback() / HAL_UART_ErrorCallback()
  66:bsp/usart/usart1_k230.c ****  *       之前已经把 RxState 复位成 READY 并中止了上一轮 DMA，
  67:bsp/usart/usart1_k230.c ****  *       所以在这两个回调里可以直接重挂，不需要先 Abort。
  68:bsp/usart/usart1_k230.c ****  */
  69:bsp/usart/usart1_k230.c **** static void K230UsartRearm(K230UsartInstance *instance)
  70:bsp/usart/usart1_k230.c **** {
  71:bsp/usart/usart1_k230.c ****     if (HAL_UARTEx_ReceiveToIdle_DMA(instance->uart_handle,
  72:bsp/usart/usart1_k230.c ****                                      instance->rx_dma_buf,
  73:bsp/usart/usart1_k230.c ****                                      instance->rx_dma_buf_size) != HAL_OK) {
  74:bsp/usart/usart1_k230.c ****         /* 重挂失败说明串口状态异常，计数后由上层通过 error_count 发现 */
  75:bsp/usart/usart1_k230.c ****         instance->error_count++;
ARM GAS  C:\Users\LJH\AppData\Local\Temp\ccX4UAse.s 			page 5


  76:bsp/usart/usart1_k230.c ****     }
  77:bsp/usart/usart1_k230.c **** }
