 215:modules/k230_to_stm32.c **** K230ToStm32Instance *K230ToStm32Register(const K230ToStm32_Init_Config_s *config)
 216:modules/k230_to_stm32.c **** {
 217:modules/k230_to_stm32.c ****     if ((config == NULL) || (config->uart_handle == NULL)) {
 218:modules/k230_to_stm32.c ****         return NULL;
 219:modules/k230_to_stm32.c ****     }
 220:modules/k230_to_stm32.c **** 
 221:modules/k230_to_stm32.c ****     K230ToStm32Instance *instance = NULL;
 222:modules/k230_to_stm32.c ****     for (uint8_t i = 0u; i < K230_TO_STM32_MAX_INSTANCE; i++) {
 223:modules/k230_to_stm32.c ****         if (k230_to_stm32_pool[i].usart_instance == NULL) {
 224:modules/k230_to_stm32.c ****             instance = &k230_to_stm32_pool[i];
 225:modules/k230_to_stm32.c ****             break;
 226:modules/k230_to_stm32.c ****         }
 227:modules/k230_to_stm32.c ****     }
 228:modules/k230_to_stm32.c ****     if (instance == NULL) {
 229:modules/k230_to_stm32.c ****         return NULL; /* 实例池已满 */
 230:modules/k230_to_stm32.c ****     }
 231:modules/k230_to_stm32.c **** 
 232:modules/k230_to_stm32.c ****     memset(instance, 0, sizeof(K230ToStm32Instance));
 233:modules/k230_to_stm32.c **** 
 234:modules/k230_to_stm32.c ****     /* 把本模块挂到 BSP 层：数据到达后由 BSP 回调 K230ToStm32OnRxData */
 235:modules/k230_to_stm32.c ****     K230Usart_Init_Config_s usart_config = {
 236:modules/k230_to_stm32.c ****         .uart_handle     = config->uart_handle,
 237:modules/k230_to_stm32.c ****         .rx_dma_buf      = instance->rx_dma_buf,
 238:modules/k230_to_stm32.c ****         .rx_dma_buf_size = K230_RX_DMA_BUF_SIZE,
 239:modules/k230_to_stm32.c ****         .parent          = instance,
 240:modules/k230_to_stm32.c ****         .rx_callback     = K230ToStm32OnRxData,
 241:modules/k230_to_stm32.c ****     };
 242:modules/k230_to_stm32.c **** 
 243:modules/k230_to_stm32.c ****     instance->usart_instance = K230UsartRegister(&usart_config);
 244:modules/k230_to_stm32.c ****     if (instance->usart_instance == NULL) {
 245:modules/k230_to_stm32.c ****         return NULL;
 246:modules/k230_to_stm32.c ****     }
 247:modules/k230_to_stm32.c **** 
 248:modules/k230_to_stm32.c ****     return instance;
 249:modules/k230_to_stm32.c **** }
