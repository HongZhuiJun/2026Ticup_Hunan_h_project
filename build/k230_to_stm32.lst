  55:modules/k230_to_stm32.c **** /* =============== 像素 → 物理位置标定表（唯一要改的地方） ===============
  56:modules/k230_to_stm32.c ****  *
  57:modules/k230_to_stm32.c ****  * 下标 i 对应物理位置 K230_CAL_MIN_CM + i * K230_CAL_STEP_CM。
  58:modules/k230_to_stm32.c ****  *
  59:modules/k230_to_stm32.c ****  * 2026-09-28 实测：把钢珠逐个放在水管 1 cm 刻度上，记录 K230 报出的像素 X�
  60:modules/k230_to_stm32.c ****  * 数据来源为 K230 侧 firmware/main_zdyz_k230.py 的 CAL_X_* 常量，
  61:modules/k230_to_stm32.c ****  * 两边必须一致——换镜头或挪动相机后重新标定，两个文件一起改。
  62:modules/k230_to_stm32.c ****  *
  63:modules/k230_to_stm32.c ****  * 表内相邻两点的差值就是该处的像素比例，畸变一眼可见：
ARM GAS  C:\Users\LJH\AppData\Local\Temp\cccQmINQ.s 			page 3


  64:modules/k230_to_stm32.c ****  *     中心 352-318=34, 318-284=34  → 34 px/cm（放大率最大）
  65:modules/k230_to_stm32.c ****  *     两端 27-6=21,   623-598=25   → 21~25 px/cm（被压缩）
  66:modules/k230_to_stm32.c ****  * 中心比边缘大 62%，所以用直线拟合必然有一头对不准。
  67:modules/k230_to_stm32.c ****  *
  68:modules/k230_to_stm32.c ****  * 硬性要求：必须随 cm 单调递增。转换函数依赖这一点做区间查找，
  69:modules/k230_to_stm32.c ****  * 否则插值结果会回跳。改完请肉眼确认一遍相邻值在变大。
  70:modules/k230_to_stm32.c ****  * ====================================================================== */
  71:modules/k230_to_stm32.c **** #define K230_CAL_MIN_CM     (-11) /* 下标 0 对应的物理位置(cm) */
  72:modules/k230_to_stm32.c **** #define K230_CAL_STEP_CM       (1) /* 相邻下标之间的物理间距(cm) */
  73:modules/k230_to_stm32.c **** #define K230_CAL_POINT_NUM    (22)
  74:modules/k230_to_stm32.c **** 
  75:modules/k230_to_stm32.c **** /* 下标 i 对应的物理位置(cm) */
  76:modules/k230_to_stm32.c **** #define K230_CAL_CM_OF_INDEX(i) (K230_CAL_MIN_CM + (int)(i) * K230_CAL_STEP_CM)
  77:modules/k230_to_stm32.c **** 
  78:modules/k230_to_stm32.c **** static const int16_t k230_cal_px[K230_CAL_POINT_NUM] = {
  79:modules/k230_to_stm32.c ****     /* -11  -10   -9   -8   -7   -6   -5   -4   -3   -2  cm */
  80:modules/k230_to_stm32.c ****         6,  27,  50,  74, 100, 128, 156, 187, 219, 251,
  81:modules/k230_to_stm32.c ****     /*  -1    0   +1   +2   +3   +4   +5   +6   +7   +8  cm */
  82:modules/k230_to_stm32.c ****       284, 318, 352, 384, 418, 451, 485, 514, 543, 571,
  83:modules/k230_to_stm32.c ****     /*  +9  +10  cm */
  84:modules/k230_to_stm32.c ****       598, 623,
  85:modules/k230_to_stm32.c **** };
