 281:modules/k230_to_stm32.c ****     }
 282:modules/k230_to_stm32.c **** 
 283:modules/k230_to_stm32.c ****     memset(instance, 0, sizeof(K230ToStm32Instance));
 284:modules/k230_to_stm32.c **** 
 285:modules/k230_to_stm32.c ****     /* 把本模块挂到 BSP 层：数据到达后由 BSP 回调 K230ToStm32OnRxData */
 286:modules/k230_to_stm32.c ****     K230Usart_Init_Config_s usart_config = {
 287:modules/k230_to_stm32.c ****         .uart_handle     = config->uart_handle,
 288:modules/k230_to_stm32.c ****         .rx_dma_buf      = instance->rx_dma_buf,
 289:modules/k230_to_stm32.c ****         .rx_dma_buf_size = K230_RX_DMA_BUF_SIZE,
 290:modules/k230_to_stm32.c ****         .parent          = instance,
