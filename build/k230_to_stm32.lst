 269:modules/k230_to_stm32.c ****         return NULL;
 270:modules/k230_to_stm32.c ****     }
 271:modules/k230_to_stm32.c **** 
 272:modules/k230_to_stm32.c ****     K230ToStm32Instance *instance = NULL;
 273:modules/k230_to_stm32.c ****     for (uint8_t i = 0u; i < K230_TO_STM32_MAX_INSTANCE; i++) {
 274:modules/k230_to_stm32.c ****         if (k230_to_stm32_pool[i].usart_instance == NULL) {
 275:modules/k230_to_stm32.c ****             instance = &k230_to_stm32_pool[i];
 276:modules/k230_to_stm32.c ****             break;
 277:modules/k230_to_stm32.c ****         }
 278:modules/k230_to_stm32.c ****     }
 279:modules/k230_to_stm32.c ****     if (instance == NULL) {
