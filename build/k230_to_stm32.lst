 270:modules/k230_to_stm32.c **** uint8_t k230_to_stm32_Init(UART_HandleTypeDef *uart_handle)
 271:modules/k230_to_stm32.c **** {
 272:modules/k230_to_stm32.c ****     K230ToStm32_Init_Config_s config = {
 273:modules/k230_to_stm32.c ****         .uart_handle = uart_handle,
 274:modules/k230_to_stm32.c ****     };
 275:modules/k230_to_stm32.c **** 
 276:modules/k230_to_stm32.c ****     /* 传入 NULL 时 K230ToStm32Register() 会直接返回 NULL，统一走下面的失败分支 
 277:modules/k230_to_stm32.c ****     k230_to_stm32_instance = K230ToStm32Register(&config);
 278:modules/k230_to_stm32.c ****     if (k230_to_stm32_instance == NULL) {
 279:modules/k230_to_stm32.c ****         return 0u;
 280:modules/k230_to_stm32.c ****     }
 281:modules/k230_to_stm32.c **** 
 282:modules/k230_to_stm32.c ****     return K230ToStm32Start(k230_to_stm32_instance);
 283:modules/k230_to_stm32.c **** }
 284:modules/k230_to_stm32.c **** 
 285:modules/k230_to_stm32.c **** K230ToStm32Instance *K230ToStm32Register(const K230ToStm32_Init_Config_s *config)
 286:modules/k230_to_stm32.c **** {
 287:modules/k230_to_stm32.c ****     if ((config == NULL) || (config->uart_handle == NULL)) {
 288:modules/k230_to_stm32.c ****         return NULL;
 289:modules/k230_to_stm32.c ****     }
 290:modules/k230_to_stm32.c **** 
 291:modules/k230_to_stm32.c ****     K230ToStm32Instance *instance = NULL;
 292:modules/k230_to_stm32.c ****     for (uint8_t i = 0u; i < K230_TO_STM32_MAX_INSTANCE; i++) {
 293:modules/k230_to_stm32.c ****         if (k230_to_stm32_pool[i].usart_instance == NULL) {
 294:modules/k230_to_stm32.c ****             instance = &k230_to_stm32_pool[i];
 295:modules/k230_to_stm32.c ****             break;
 296:modules/k230_to_stm32.c ****         }
 297:modules/k230_to_stm32.c ****     }
 298:modules/k230_to_stm32.c ****     if (instance == NULL) {
 299:modules/k230_to_stm32.c ****         return NULL; /* 实例池已满 */
 300:modules/k230_to_stm32.c ****     }
 301:modules/k230_to_stm32.c **** 
 302:modules/k230_to_stm32.c ****     memset(instance, 0, sizeof(K230ToStm32Instance));
 303:modules/k230_to_stm32.c **** 
 304:modules/k230_to_stm32.c ****     /* 把本模块挂到 BSP 层：数据到达后由 BSP 回调 K230ToStm32OnRxData */
 305:modules/k230_to_stm32.c ****     K230Usart_Init_Config_s usart_config = {
 306:modules/k230_to_stm32.c ****         .uart_handle     = config->uart_handle,
 307:modules/k230_to_stm32.c ****         .rx_dma_buf      = instance->rx_dma_buf,
 308:modules/k230_to_stm32.c ****         .rx_dma_buf_size = K230_RX_DMA_BUF_SIZE,
 309:modules/k230_to_stm32.c ****         .parent          = instance,
 310:modules/k230_to_stm32.c ****         .rx_callback     = K230ToStm32OnRxData,
 311:modules/k230_to_stm32.c ****     };
 312:modules/k230_to_stm32.c **** 
 313:modules/k230_to_stm32.c ****     instance->usart_instance = K230UsartRegister(&usart_config);
 314:modules/k230_to_stm32.c ****     if (instance->usart_instance == NULL) {
 315:modules/k230_to_stm32.c ****         return NULL;
 316:modules/k230_to_stm32.c ****     }
 317:modules/k230_to_stm32.c **** 
 318:modules/k230_to_stm32.c ****     return instance;
 319:modules/k230_to_stm32.c **** }
