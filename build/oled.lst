 708:modules/oled.c **** void OLED_ShowHexNum(int16_t X, int16_t Y, uint32_t Number, uint8_t Length, uint8_t FontSize)
 709:modules/oled.c **** {
 710:modules/oled.c **** 	uint8_t i, SingleNumber;
 711:modules/oled.c **** 	for (i = 0; i < Length; i++)		//遍历数字的每一位
 712:modules/oled.c **** 	{
 713:modules/oled.c **** 		/*以十六进制提取数字的每一位*/
