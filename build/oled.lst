 176:modules/oled.c **** /*硬件配置*********************/
 177:modules/oled.c **** 
 178:modules/oled.c **** /**
 179:modules/oled.c ****   * 函    数：OLED初始化
 180:modules/oled.c ****   * 参    数：无
 181:modules/oled.c ****   * 返 回 值：无
 182:modules/oled.c ****   * 说    明：使用前，需要调用此初始化函数
 183:modules/oled.c ****   */
 184:modules/oled.c **** void OLED_Init(void)
 185:modules/oled.c **** {
 186:modules/oled.c **** 	OLED_GPIO_Init();			//先调用底层的端口初始化
 187:modules/oled.c **** 	
 188:modules/oled.c **** 	/*写入一系列的命令，对OLED进行初始化配置*/
 189:modules/oled.c **** 	OLED_WriteCommand(0xAE);	//设置显示开启/关闭，0xAE关闭，0xAF开启
 190:modules/oled.c **** 	
 191:modules/oled.c **** 	OLED_WriteCommand(0xD5);	//设置显示时钟分频比/振荡器频率
 192:modules/oled.c **** 	OLED_WriteCommand(0x80);	//0x00~0xFF
 193:modules/oled.c **** 	
 194:modules/oled.c **** 	OLED_WriteCommand(0xA8);	//设置多路复用率
 195:modules/oled.c **** 	OLED_WriteCommand(0x3F);	//0x0E~0x3F
 196:modules/oled.c **** 	
 197:modules/oled.c **** 	OLED_WriteCommand(0xD3);	//设置显示偏移
 198:modules/oled.c **** 	OLED_WriteCommand(0x00);	//0x00~0x7F
 199:modules/oled.c **** 	
 200:modules/oled.c **** 	OLED_WriteCommand(0x40);	//设置显示开始行，0x40~0x7F
 201:modules/oled.c **** 	
 202:modules/oled.c **** 	OLED_WriteCommand(0xA1);	//设置左右方向，0xA1正常，0xA0左右反置
 203:modules/oled.c **** 	
 204:modules/oled.c **** 	OLED_WriteCommand(0xC8);	//设置上下方向，0xC8正常，0xC0上下反置
 205:modules/oled.c **** 
 206:modules/oled.c **** 	OLED_WriteCommand(0xDA);	//设置COM引脚硬件配置
 207:modules/oled.c **** 	OLED_WriteCommand(0x12);
 208:modules/oled.c **** 	
 209:modules/oled.c **** 	OLED_WriteCommand(0x81);	//设置对比度
 210:modules/oled.c **** 	OLED_WriteCommand(0xCF);	//0x00~0xFF
 211:modules/oled.c **** 
 212:modules/oled.c **** 	OLED_WriteCommand(0xD9);	//设置预充电周期
 213:modules/oled.c **** 	OLED_WriteCommand(0xF1);
 214:modules/oled.c **** 
 215:modules/oled.c **** 	OLED_WriteCommand(0xDB);	//设置VCOMH取消选择级别
 216:modules/oled.c **** 	OLED_WriteCommand(0x30);
 217:modules/oled.c **** 
 218:modules/oled.c **** 	OLED_WriteCommand(0xA4);	//设置整个显示打开/关闭
 219:modules/oled.c **** 
 220:modules/oled.c **** 	OLED_WriteCommand(0xA6);	//设置正常/反色显示，0xA6正常，0xA7反色
 221:modules/oled.c **** 
 222:modules/oled.c **** 	OLED_WriteCommand(0x8D);	//设置充电泵
 223:modules/oled.c **** 	OLED_WriteCommand(0x14);
 224:modules/oled.c **** 
 225:modules/oled.c **** 	OLED_WriteCommand(0xAF);	//开启显示
 226:modules/oled.c **** 	
 227:modules/oled.c **** 	OLED_Clear();				//清空显存数组
 228:modules/oled.c **** 	OLED_Update();				//更新显示，清屏，防止初始化后未显示内容时花屏
 229:modules/oled.c **** }
