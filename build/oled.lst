 719:modules/oled.c **** 			/*+ '0' 可将数字转换为字符格式*/
 720:modules/oled.c **** 			OLED_ShowChar(X + i * FontSize, Y, SingleNumber + '0', FontSize);
 721:modules/oled.c **** 		}
 722:modules/oled.c **** 		else							//单个数字大于10
 723:modules/oled.c **** 		{
 724:modules/oled.c **** 			/*调用OLED_ShowChar函数，显示此数字*/
 725:modules/oled.c **** 			/*+ 'A' 可将数字转换为从A开始的十六进制字符*/
 726:modules/oled.c **** 			OLED_ShowChar(X + i * FontSize, Y, SingleNumber - 10 + 'A', FontSize);
 727:modules/oled.c **** 		}
 728:modules/oled.c **** 	}
 729:modules/oled.c **** }
