 484:modules/oled.c **** /**
 485:modules/oled.c ****   * 函    数：OLED显示一个字符
 486:modules/oled.c ****   * 参    数：X 指定字符左上角的横坐标，范围：-32768~32767，屏幕区域：0~127
 487:modules/oled.c ****   * 参    数：Y 指定字符左上角的纵坐标，范围：-32768~32767，屏幕区域：0~63
 488:modules/oled.c ****   * 参    数：Char 指定要显示的字符，范围：ASCII码可见字符
 489:modules/oled.c ****   * 参    数：FontSize 指定字体大小
 490:modules/oled.c ****   *           范围：OLED_8X16		宽8像素，高16像素
 491:modules/oled.c ****   *                 OLED_6X8		宽6像素，高8像素
 492:modules/oled.c ****   * 返 回 值：无
 493:modules/oled.c ****   * 说    明：调用此函数后，要想真正地呈现在屏幕上，还需调用更新函数
 494:modules/oled.c ****   */
 495:modules/oled.c **** void OLED_ShowChar(int16_t X, int16_t Y, char Char, uint8_t FontSize)
 496:modules/oled.c **** {
 497:modules/oled.c **** 	if (FontSize == OLED_8X16)		//字体为宽8像素，高16像素
 498:modules/oled.c **** 	{
 499:modules/oled.c **** 		/*将ASCII字模库OLED_F8x16的指定数据以8*16的图像格式显示*/
 500:modules/oled.c **** 		OLED_ShowImage(X, Y, 8, 16, OLED_F8x16[Char - ' ']);
 501:modules/oled.c **** 	}
 502:modules/oled.c **** 	else if(FontSize == OLED_6X8)	//字体为宽6像素，高8像素
 503:modules/oled.c **** 	{
 504:modules/oled.c **** 		/*将ASCII字模库OLED_F6x8的指定数据以6*8的图像格式显示*/
 505:modules/oled.c **** 		OLED_ShowImage(X, Y, 6, 8, OLED_F6x8[Char - ' ']);
 506:modules/oled.c **** 	}
 507:modules/oled.c **** }
 508:modules/oled.c **** 
 509:modules/oled.c **** /**
 510:modules/oled.c ****   * 函    数：OLED显示字符串（支持ASCII码和中文混合写入）
 511:modules/oled.c ****   * 参    数：X 指定字符串左上角的横坐标，范围：-32768~32767，屏幕区域：0~
 512:modules/oled.c ****   * 参    数：Y 指定字符串左上角的纵坐标，范围：-32768~32767，屏幕区域：0~
 513:modules/oled.c ****   * 参    数：String 指定要显示的字符串，范围：ASCII码可见字符或中文字符�
 514:modules/oled.c ****   * 参    数：FontSize 指定字体大小
 515:modules/oled.c ****   *           范围：OLED_8X16		宽8像素，高16像素
 516:modules/oled.c ****   *                 OLED_6X8		宽6像素，高8像素
 517:modules/oled.c ****   * 返 回 值：无
 518:modules/oled.c ****   * 说    明：显示的中文字符需要在OLED_Data.c里的OLED_CF16x16数组定义
 519:modules/oled.c ****   *           未找到指定中文字符时，会显示默认图形（一个方框，内部一个�
 520:modules/oled.c ****   *           当字体大小为OLED_8X16时，中文字符以16*16点阵正常显示
 521:modules/oled.c ****   *           当字体大小为OLED_6X8时，中文字符以6*8点阵显示'?'
 522:modules/oled.c ****   * 说    明：调用此函数后，要想真正地呈现在屏幕上，还需调用更新函数
 523:modules/oled.c ****   */
 524:modules/oled.c **** void OLED_ShowString(int16_t X, int16_t Y, char *String, uint8_t FontSize)
 525:modules/oled.c **** {
 526:modules/oled.c **** 	uint16_t i = 0;
 527:modules/oled.c **** 	char SingleChar[5];
 528:modules/oled.c **** 	uint8_t CharLength = 0;
 529:modules/oled.c **** 	uint16_t XOffset = 0;
ARM GAS  C:\Users\LJH\AppData\Local\Temp\cccXgUgw.s 			page 34


 530:modules/oled.c **** 	uint16_t pIndex;
 531:modules/oled.c **** 	
 532:modules/oled.c **** 	while (String[i] != '\0')	//遍历字符串
 533:modules/oled.c **** 	{
 534:modules/oled.c **** 		
 535:modules/oled.c **** #ifdef OLED_CHARSET_UTF8						//定义字符集为UTF8
 536:modules/oled.c **** 		/*此段代码的目的是，提取UTF8字符串中的一个字符，转存到SingleChar子字符
 537:modules/oled.c **** 		/*判断UTF8编码第一个字节的标志位*/
 538:modules/oled.c **** 		if ((String[i] & 0x80) == 0x00)			//第一个字节为0xxxxxxx
 539:modules/oled.c **** 		{
 540:modules/oled.c **** 			CharLength = 1;						//字符为1字节
 541:modules/oled.c **** 			SingleChar[0] = String[i ++];		//将第一个字节写入SingleChar第0个位置，随后i指向
 542:modules/oled.c **** 			SingleChar[1] = '\0';				//为SingleChar添加字符串结束标志位
 543:modules/oled.c **** 		}
 544:modules/oled.c **** 		else if ((String[i] & 0xE0) == 0xC0)	//第一个字节为110xxxxx
 545:modules/oled.c **** 		{
 546:modules/oled.c **** 			CharLength = 2;						//字符为2字节
 547:modules/oled.c **** 			SingleChar[0] = String[i ++];		//将第一个字节写入SingleChar第0个位置，随后i指向
 548:modules/oled.c **** 			if (String[i] == '\0') {break;}		//意外情况，跳出循环，结束显示
 549:modules/oled.c **** 			SingleChar[1] = String[i ++];		//将第二个字节写入SingleChar第1个位置，随后i指向
 550:modules/oled.c **** 			SingleChar[2] = '\0';				//为SingleChar添加字符串结束标志位
 551:modules/oled.c **** 		}
 552:modules/oled.c **** 		else if ((String[i] & 0xF0) == 0xE0)	//第一个字节为1110xxxx
 553:modules/oled.c **** 		{
 554:modules/oled.c **** 			CharLength = 3;						//字符为3字节
 555:modules/oled.c **** 			SingleChar[0] = String[i ++];
 556:modules/oled.c **** 			if (String[i] == '\0') {break;}
 557:modules/oled.c **** 			SingleChar[1] = String[i ++];
 558:modules/oled.c **** 			if (String[i] == '\0') {break;}
 559:modules/oled.c **** 			SingleChar[2] = String[i ++];
 560:modules/oled.c **** 			SingleChar[3] = '\0';
 561:modules/oled.c **** 		}
 562:modules/oled.c **** 		else if ((String[i] & 0xF8) == 0xF0)	//第一个字节为11110xxx
 563:modules/oled.c **** 		{
 564:modules/oled.c **** 			CharLength = 4;						//字符为4字节
 565:modules/oled.c **** 			SingleChar[0] = String[i ++];
 566:modules/oled.c **** 			if (String[i] == '\0') {break;}
 567:modules/oled.c **** 			SingleChar[1] = String[i ++];
 568:modules/oled.c **** 			if (String[i] == '\0') {break;}
 569:modules/oled.c **** 			SingleChar[2] = String[i ++];
 570:modules/oled.c **** 			if (String[i] == '\0') {break;}
 571:modules/oled.c **** 			SingleChar[3] = String[i ++];
 572:modules/oled.c **** 			SingleChar[4] = '\0';
 573:modules/oled.c **** 		}
 574:modules/oled.c **** 		else
 575:modules/oled.c **** 		{
 576:modules/oled.c **** 			i ++;			//意外情况，i指向下一个字节，忽略此字节，继续判断下一个字节
 577:modules/oled.c **** 			continue;
 578:modules/oled.c **** 		}
 579:modules/oled.c **** #endif
 580:modules/oled.c **** 		
 581:modules/oled.c **** #ifdef OLED_CHARSET_GB2312						//定义字符集为GB2312
 582:modules/oled.c **** 		/*此段代码的目的是，提取GB2312字符串中的一个字符，转存到SingleChar子字�
 583:modules/oled.c **** 		/*判断GB2312字节的最高位标志位*/
 584:modules/oled.c **** 		if ((String[i] & 0x80) == 0x00)			//最高位为0
 585:modules/oled.c **** 		{
 586:modules/oled.c **** 			CharLength = 1;						//字符为1字节
ARM GAS  C:\Users\LJH\AppData\Local\Temp\cccXgUgw.s 			page 35


 587:modules/oled.c **** 			SingleChar[0] = String[i ++];		//将第一个字节写入SingleChar第0个位置，随后i指向
 588:modules/oled.c **** 			SingleChar[1] = '\0';				//为SingleChar添加字符串结束标志位
 589:modules/oled.c **** 		}
 590:modules/oled.c **** 		else									//最高位为1
 591:modules/oled.c **** 		{
 592:modules/oled.c **** 			CharLength = 2;						//字符为2字节
 593:modules/oled.c **** 			SingleChar[0] = String[i ++];		//将第一个字节写入SingleChar第0个位置，随后i指向
 594:modules/oled.c **** 			if (String[i] == '\0') {break;}		//意外情况，跳出循环，结束显示
 595:modules/oled.c **** 			SingleChar[1] = String[i ++];		//将第二个字节写入SingleChar第1个位置，随后i指向
 596:modules/oled.c **** 			SingleChar[2] = '\0';				//为SingleChar添加字符串结束标志位
 597:modules/oled.c **** 		}
 598:modules/oled.c **** #endif
 599:modules/oled.c **** 		
 600:modules/oled.c **** 		/*显示上述代码提取到的SingleChar*/
 601:modules/oled.c **** 		if (CharLength == 1)	//如果是单字节字符
 602:modules/oled.c **** 		{
 603:modules/oled.c **** 			/*使用OLED_ShowChar显示此字符*/
 604:modules/oled.c **** 			OLED_ShowChar(X + XOffset, Y, SingleChar[0], FontSize);
 605:modules/oled.c **** 			XOffset += FontSize;
 606:modules/oled.c **** 		}
 607:modules/oled.c **** 		else					//否则，即多字节字符
 608:modules/oled.c **** 		{
 609:modules/oled.c **** 			/*遍历整个字模库，从字模库中寻找此字符的数据*/
 610:modules/oled.c **** 			/*如果找到最后一个字符（定义为空字符串），则表示字符未在字模库定�
 611:modules/oled.c **** 			for (pIndex = 0; strcmp(OLED_CF16x16[pIndex].Index, "") != 0; pIndex ++)
 612:modules/oled.c **** 			{
 613:modules/oled.c **** 				/*找到匹配的字符*/
 614:modules/oled.c **** 				if (strcmp(OLED_CF16x16[pIndex].Index, SingleChar) == 0)
 615:modules/oled.c **** 				{
 616:modules/oled.c **** 					break;		//跳出循环，此时pIndex的值为指定字符的索引
 617:modules/oled.c **** 				}
 618:modules/oled.c **** 			}
 619:modules/oled.c **** 			if (FontSize == OLED_8X16)		//给定字体为8*16点阵
 620:modules/oled.c **** 			{
 621:modules/oled.c **** 				/*将字模库OLED_CF16x16的指定数据以16*16的图像格式显示*/
