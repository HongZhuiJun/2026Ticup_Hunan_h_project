 623:modules/oled.c **** 				XOffset += 16;
 624:modules/oled.c **** 			}
 625:modules/oled.c **** 			else if (FontSize == OLED_6X8)	//给定字体为6*8点阵
 626:modules/oled.c **** 			{
 627:modules/oled.c **** 				/*空间不足，此位置显示'?'*/
