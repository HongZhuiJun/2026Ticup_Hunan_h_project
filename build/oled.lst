 768:modules/oled.c **** void OLED_ShowFloatNum(int16_t X, int16_t Y, double Number, uint8_t IntLength, uint8_t FraLength, u
 769:modules/oled.c **** {
 770:modules/oled.c **** 	uint32_t PowNum, IntNum, FraNum;
 771:modules/oled.c **** 	
 772:modules/oled.c **** 	if (Number >= 0)						//数字大于等于0
 773:modules/oled.c **** 	{
 774:modules/oled.c **** 		OLED_ShowChar(X, Y, '+', FontSize);	//显示+号
 775:modules/oled.c **** 	}
 776:modules/oled.c **** 	else									//数字小于0
 777:modules/oled.c **** 	{
 778:modules/oled.c **** 		OLED_ShowChar(X, Y, '-', FontSize);	//显示-号
 779:modules/oled.c **** 		Number = -Number;					//Number取负
 780:modules/oled.c **** 	}
 781:modules/oled.c **** 	
 782:modules/oled.c **** 	/*提取整数部分和小数部分*/
 783:modules/oled.c **** 	IntNum = Number;						//直接赋值给整型变量，提取整数
 784:modules/oled.c **** 	Number -= IntNum;						//将Number的整数减掉，防止之后将小数乘到整数时因数过�
 785:modules/oled.c **** 	PowNum = OLED_Pow(10, FraLength);		//根据指定小数的位数，确定乘数
 786:modules/oled.c **** 	FraNum = round(Number * PowNum);		//将小数乘到整数，同时四舍五入，避免显示误�
 787:modules/oled.c **** 	IntNum += FraNum / PowNum;				//若四舍五入造成了进位，则需要再加给整数
 788:modules/oled.c **** 	
 789:modules/oled.c **** 	/*显示整数部分*/
 790:modules/oled.c **** 	OLED_ShowNum(X + FontSize, Y, IntNum, IntLength, FontSize);
 791:modules/oled.c **** 	
 792:modules/oled.c **** 	/*显示小数点*/
 793:modules/oled.c **** 	OLED_ShowChar(X + (IntLength + 1) * FontSize, Y, '.', FontSize);
 794:modules/oled.c **** 	
 795:modules/oled.c **** 	/*显示小数部分*/
 796:modules/oled.c **** 	OLED_ShowNum(X + (IntLength + 2) * FontSize, Y, FraNum, FraLength, FontSize);
 797:modules/oled.c **** }
