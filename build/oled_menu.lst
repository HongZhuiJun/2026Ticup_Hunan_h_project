 307:modules/oled_menu.c **** /**
 308:modules/oled_menu.c ****  * @brief 三级菜单循环：每轮执行一次任务函数，直到按 KEY3 返回。
 309:modules/oled_menu.c ****  *
 310:modules/oled_menu.c ****  * @param task 要执行的任务编号
 311:modules/oled_menu.c ****  */
 312:modules/oled_menu.c **** static void menu3_run(Menu_Task_e task)
 313:modules/oled_menu.c **** {
 314:modules/oled_menu.c ****     uint8_t key_num;
 315:modules/oled_menu.c **** 
 316:modules/oled_menu.c ****     while (1) {
 317:modules/oled_menu.c ****         /* 任务体每轮执行一次。菜单持有的是函数指针，本模块不知道
 318:modules/oled_menu.c ****            任务具体是什么，也就不会混进控制代码 */
 319:modules/oled_menu.c ****         menu_task_run(task);
 320:modules/oled_menu.c **** 
 321:modules/oled_menu.c ****         key_num = Key_GetNum();
 322:modules/oled_menu.c ****         if (key_num == KEY_NUM_KEY3) {
 323:modules/oled_menu.c ****             return;                 /* 上一步：回到二级菜单 */
 324:modules/oled_menu.c ****         }
 325:modules/oled_menu.c **** 
 326:modules/oled_menu.c ****         menu3_show();
 327:modules/oled_menu.c ****     }
 328:modules/oled_menu.c **** }
