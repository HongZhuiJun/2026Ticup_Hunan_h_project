  35:modules/oled_menu.c **** #define MENU1_ENTRY_PERFORMANCE  1u
  36:modules/oled_menu.c **** #define MENU1_FIRST_ROW          2u   /* 两个选项显示在第 3、4 行，行号从 0 开始 */
  37:modules/oled_menu.c **** 
  38:modules/oled_menu.c **** /*--------------------------- 二级菜单：基础部分 ----------------------------*/
