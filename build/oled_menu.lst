 252:modules/oled_menu.c **** static void menu2_performance_show(uint8_t entry)
 253:modules/oled_menu.c **** {
 254:modules/oled_menu.c ****     OLED_Clear();
 255:modules/oled_menu.c ****     /* 目标位置就显示在第 1 行，光标停在这一行按确认即开始执行任务 */
 256:modules/oled_menu.c ****     OLED_Printf(0, menu_row_to_y(0u), OLED_8X16, "指定位置:%dcm   ", specified_location_cm);
 257:modules/oled_menu.c ****     OLED_ShowString(0, menu_row_to_y(1u), MENU_BACK_TEXT, OLED_8X16);
 258:modules/oled_menu.c ****     OLED_ShowString(0, menu_row_to_y(2u), "  +1cm          ", OLED_8X16);
 259:modules/oled_menu.c ****     OLED_ShowString(0, menu_row_to_y(3u), "  -1cm          ", OLED_8X16);
 260:modules/oled_menu.c **** 
 261:modules/oled_menu.c ****     menu_highlight(entry);
 262:modules/oled_menu.c ****     OLED_Update();
 263:modules/oled_menu.c **** }
