 290:modules/oled_menu.c **** /**
 291:modules/oled_menu.c ****  * @brief 三级菜单循环：每轮执行一次任务函数，直到按 KEY3 返回。
 292:modules/oled_menu.c ****  *
 293:modules/oled_menu.c ****  * @param task 要执行的任务编号
 294:modules/oled_menu.c ****  */
 295:modules/oled_menu.c **** static void menu3_run(Menu_Task_e task)
 296:modules/oled_menu.c **** {
 297:modules/oled_menu.c ****     uint8_t key_num;
 298:modules/oled_menu.c **** 
 299:modules/oled_menu.c ****     while (1) {
 300:modules/oled_menu.c ****         /* 任务体每轮执行一次。菜单持有的是函数指针，本模块不知道
 301:modules/oled_menu.c ****            任务具体是什么，也就不会混进控制代码 */
 302:modules/oled_menu.c ****         menu_task_run(task);
 303:modules/oled_menu.c **** 
 304:modules/oled_menu.c ****         key_num = Key_GetNum();
 305:modules/oled_menu.c ****         if (key_num == KEY_NUM_KEY3) {
 306:modules/oled_menu.c ****             return;                 /* 上一步：回到二级菜单 */
 307:modules/oled_menu.c ****         }
 308:modules/oled_menu.c **** 
 309:modules/oled_menu.c ****         menu3_show();
 310:modules/oled_menu.c ****     }
 311:modules/oled_menu.c **** }
