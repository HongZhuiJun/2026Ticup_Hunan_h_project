   1:modules/oled_menu.c **** /**
   2:modules/oled_menu.c ****  * @file oled_menu.c
   3:modules/oled_menu.c ****  * @brief OLED 三级菜单框架（模块层）。只负责显示与按键，不含任何控制代
   4:modules/oled_menu.c ****  *
   5:modules/oled_menu.c ****  * 菜单结构：
   6:modules/oled_menu.c ****  *   一级菜单：基础部分 / 发挥部分，光标只在第 3、4 行之间移动
   7:modules/oled_menu.c ****  *   二级菜单：基础部分 = 4 个任务 + "上一步"
   8:modules/oled_menu.c ****  *             发挥部分 = 指定位置(确认即执行任务) + "上一步" + 位置 +1cm / -1c
   9:modules/oled_menu.c ****  *   三级菜单：任务执行页，循环显示小球位置，确认后返回二级菜单
  10:modules/oled_menu.c ****  *
  11:modules/oled_menu.c ****  * 按键（见 key.h）：KEY1 上移，KEY2 下移，KEY3 确认。
  12:modules/oled_menu.c ****  *   光标在首项时按 KEY1 回绕到末项，在末项时按 KEY2 回绕到首项。
  13:modules/oled_menu.c ****  *
  14:modules/oled_menu.c ****  * 任务函数不在本文件里：由 Application 层通过 OLEDMenu_RegisterTask() 注册，
  15:modules/oled_menu.c ****  * 本文件只在任务页每轮通过 menu_task_table[] 里的函数指针调用一次，
  16:modules/oled_menu.c ****  * 因此本模块不包含任何 Application 头文件。
  17:modules/oled_menu.c ****  *
  18:modules/oled_menu.c ****  * 注意：
  19:modules/oled_menu.c ****  *   1. 一帧只在最后调用一次 OLED_Update()，刷新过慢会导致按键漏检。
  20:modules/oled_menu.c ****  *   2. 任务页每轮循环都会清屏重绘，任务代码需要用
  21:modules/oled_menu.c ****  *      OLEDMenu_SetBallPositionCm() 把位置交给菜单来画，
  22:modules/oled_menu.c ****  *      不要在任务里直接调用 OLED 画图，否则会被清掉。
  23:modules/oled_menu.c ****  */
  24:modules/oled_menu.c **** 
  25:modules/oled_menu.c **** #include "oled_menu.h"
  26:modules/oled_menu.c **** #include "oled.h"
  27:modules/oled_menu.c **** #include "key.h"
  28:modules/oled_menu.c **** #include <stddef.h>   /* NULL */
  29:modules/oled_menu.c **** 
  30:modules/oled_menu.c **** /*-------------------------------- 显示布局 --------------------------------*/
  31:modules/oled_menu.c **** #define MENU_ROW_HEIGHT   16u   /* OLED_8X16 字体行高，单位：像素 */
  32:modules/oled_menu.c **** #define MENU_ROW_NUM       4u   /* 屏幕可显示的行数 */
ARM GAS  C:\Users\LJH\AppData\Local\Temp\cc1pOd2K.s 			page 2


  33:modules/oled_menu.c **** #define MENU_ITEM_WIDTH  128u   /* 光标反相区域的宽度，单位：像素 */
  34:modules/oled_menu.c **** 
  35:modules/oled_menu.c **** /*-------------------------------- 一级菜单 --------------------------------*/
  36:modules/oled_menu.c **** #define MENU1_ENTRY_NUM          2u   /* 基础部分、发挥部分 */
  37:modules/oled_menu.c **** #define MENU1_ENTRY_BASIC        0u
  38:modules/oled_menu.c **** #define MENU1_ENTRY_PERFORMANCE  1u
  39:modules/oled_menu.c **** #define MENU1_FIRST_ROW          2u   /* 两个选项显示在第 3、4 行，行号从 0 开始 */
  40:modules/oled_menu.c **** 
  41:modules/oled_menu.c **** /*--------------------------- 二级菜单：基础部分 ----------------------------*/
  42:modules/oled_menu.c **** #define MENU2_BASIC_TASK_NUM     4u                            /* 基础任务数量 */
  43:modules/oled_menu.c **** #define MENU2_BASIC_ENTRY_NUM    (MENU2_BASIC_TASK_NUM + 1u)   /* 末项是"上一步" */
  44:modules/oled_menu.c **** #define MENU2_BASIC_BACK_ENTRY   MENU2_BASIC_TASK_NUM          /* "上一步"的条目序号 */
  45:modules/oled_menu.c **** 
  46:modules/oled_menu.c **** /*--------------------------- 二级菜单：发挥部分 ----------------------------*/
