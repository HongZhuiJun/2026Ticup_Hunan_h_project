   1:modules/oled_menu.c **** /**
   2:modules/oled_menu.c ****  * @file oled_menu.c
   3:modules/oled_menu.c ****  * @brief OLED 三级菜单框架（模块层）。
   4:modules/oled_menu.c ****  *
   5:modules/oled_menu.c ****  * 菜单结构：
   6:modules/oled_menu.c ****  *   一级菜单：基础部分 / 发挥部分，光标只在第 3、4 行之间移动
   7:modules/oled_menu.c ****  *   二级菜单：基础部分 = 4 个任务 + "上一步"
   8:modules/oled_menu.c ****  *             发挥部分 = 指定位置(确认即执行任务) + "上一步" + 位置 +1cm / -1c
   9:modules/oled_menu.c ****  *   三级菜单：任务执行页，循环显示小球位置，确认后返回二级菜单
  10:modules/oled_menu.c ****  *
  11:modules/oled_menu.c ****  * 按键（见 key.h）：KEY1 上移，KEY2 下移，KEY3 确认。
  12:modules/oled_menu.c ****  *   光标在首项时按 KEY1 回绕到末项，在末项时按 KEY2 回绕到首项。
  13:modules/oled_menu.c ****  *
  14:modules/oled_menu.c ****  * 三级菜单里的任务执行函数还没有写，已经用 TODO 注释标出填入位置，
  15:modules/oled_menu.c ****  * 该注释所在的 switch 分支在任务页里每轮循环执行一次。
  16:modules/oled_menu.c ****  *
  17:modules/oled_menu.c ****  * 注意：
  18:modules/oled_menu.c ****  *   1. 一帧只在最后调用一次 OLED_Update()，刷新过慢会导致按键漏检。
  19:modules/oled_menu.c ****  *   2. 任务页每轮循环都会清屏重绘，任务代码只要更新 location_cm 即可，
  20:modules/oled_menu.c ****  *      不要在任务里直接调用 OLED 画图，否则会被清掉。
  21:modules/oled_menu.c ****  */
  22:modules/oled_menu.c **** 
  23:modules/oled_menu.c **** #include "oled_menu.h"
  24:modules/oled_menu.c **** #include "oled.h"
  25:modules/oled_menu.c **** #include "key.h"
  26:modules/oled_menu.c **** 
  27:modules/oled_menu.c **** /*-------------------------------- 显示布局 --------------------------------*/
  28:modules/oled_menu.c **** #define MENU_ROW_HEIGHT   16u   /* OLED_8X16 字体行高，单位：像素 */
  29:modules/oled_menu.c **** #define MENU_ROW_NUM       4u   /* 屏幕可显示的行数 */
  30:modules/oled_menu.c **** #define MENU_ITEM_WIDTH  128u   /* 光标反相区域的宽度，单位：像素 */
  31:modules/oled_menu.c **** 
  32:modules/oled_menu.c **** /*-------------------------------- 一级菜单 --------------------------------*/
ARM GAS  C:\Users\LJH\AppData\Local\Temp\ccUX2mPO.s 			page 2


  33:modules/oled_menu.c **** #define MENU1_ENTRY_NUM          2u   /* 基础部分、发挥部分 */
