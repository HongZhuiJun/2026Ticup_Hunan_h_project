 227:modules/oled_menu.c ****  */
 228:modules/oled_menu.c **** static void menu2_basic_show(uint8_t offset, uint8_t entry)
 229:modules/oled_menu.c **** {
 230:modules/oled_menu.c ****     OLED_Clear();
 231:modules/oled_menu.c ****     uint8_t row;
 232:modules/oled_menu.c **** 
 233:modules/oled_menu.c ****     for (row = 0u; row < MENU_ROW_NUM; row++) {
 234:modules/oled_menu.c ****         uint8_t item = (uint8_t)(offset + row);
 235:modules/oled_menu.c **** 
 236:modules/oled_menu.c ****         if (item < MENU2_BASIC_TASK_NUM) {
 237:modules/oled_menu.c ****             OLED_ShowString(0, menu_row_to_y(row), kMenu2BasicItem[item].text, OLED_8X16);
 238:modules/oled_menu.c ****         } else {
