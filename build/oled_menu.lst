  56:modules/oled_menu.c **** #define MENU_TARGET_POSITION_MIN_CM  (-10)   /* 目标位置下限，单位：cm */
  57:modules/oled_menu.c **** 
  58:modules/oled_menu.c **** /*-------------------------------- 三级菜单 --------------------------------*/
  59:modules/oled_menu.c **** #define MENU3_BACK_HINT_ROW   3u   /* "上一步"提示显示在第 4 行，行号从 0 开始 */
  60:modules/oled_menu.c **** #define MENU3_BACK_HINT_TEXT  "<-上一步        "
  61:modules/oled_menu.c **** 
  62:modules/oled_menu.c **** /* "上一步"条目文本，补足空格把整行填满，避免残留上一帧的字符 */
  63:modules/oled_menu.c **** #define MENU_BACK_TEXT        "<-上一步        "
  64:modules/oled_menu.c **** 
