 427:application/ball_control.c **** /* ============================ 任务函数 ============================ */
 428:application/ball_control.c **** 
 429:application/ball_control.c **** /**
 430:application/ball_control.c ****  * @brief 任务1：定点稳定控制。
 431:application/ball_control.c ****  *
 432:application/ball_control.c ****  * 流程：
 433:application/ball_control.c ****  *   phase 0：移动到 +6cm，稳定 3 秒；
 434:application/ball_control.c ****  *   phase 1：移动到 -6cm，稳定 3 秒；
 435:application/ball_control.c ****  *   phase 2：保持在 -6cm。
 436:application/ball_control.c ****  */
 437:application/ball_control.c **** static void ball_control_task_stable_position(void)
 438:application/ball_control.c **** {
 439:application/ball_control.c ****     BallControl_BeginTask(MENU_TASK_STABLE_POSITION);
 440:application/ball_control.c **** 
 441:application/ball_control.c ****     if (ball_control.task_phase == 0u) {
 442:application/ball_control.c ****         ball_control.target_cm = 6.0f;
 443:application/ball_control.c ****         if (BallControl_Update(BALL_REF_RAMP) != 0u) {
 444:application/ball_control.c ****             if (BallControl_IsStable(BALL_STABLE_ERROR_CM) != 0u) {
 445:application/ball_control.c ****                 ball_control.stable_time_s += ball_control.last_dt_s;
 446:application/ball_control.c ****                 if (ball_control.stable_time_s >= BALL_STABLE_TIME_S) {
 447:application/ball_control.c ****                     ball_control.task_phase = 1u;
 448:application/ball_control.c ****                     ball_control.stable_time_s = 0.0f;
 449:application/ball_control.c ****                     PIDResetIntegral(&ball_control.pid);
 450:application/ball_control.c ****                 }
 451:application/ball_control.c ****             } else {
 452:application/ball_control.c ****                 ball_control.stable_time_s = 0.0f;
 453:application/ball_control.c ****             }
 454:application/ball_control.c ****         }
 455:application/ball_control.c ****     } else if (ball_control.task_phase == 1u) {
 456:application/ball_control.c ****         ball_control.target_cm = -6.0f;
 457:application/ball_control.c ****         if (BallControl_Update(BALL_REF_RAMP) != 0u) {
 458:application/ball_control.c ****             if (BallControl_IsStable(BALL_STABLE_ERROR_CM) != 0u) {
 459:application/ball_control.c ****                 ball_control.stable_time_s += ball_control.last_dt_s;
ARM GAS  C:\Users\LJH\AppData\Local\Temp\cc4ibJG6.s 			page 44


 460:application/ball_control.c ****                 if (ball_control.stable_time_s >= BALL_STABLE_TIME_S) {
 461:application/ball_control.c ****                     ball_control.task_phase = 2u;
 462:application/ball_control.c ****                     ball_control.stable_time_s = 0.0f;
 463:application/ball_control.c ****                     PIDResetIntegral(&ball_control.pid);
 464:application/ball_control.c ****                 }
 465:application/ball_control.c ****             } else {
 466:application/ball_control.c ****                 ball_control.stable_time_s = 0.0f;
 467:application/ball_control.c ****             }
 468:application/ball_control.c ****         }
 469:application/ball_control.c ****     } else {
 470:application/ball_control.c ****         ball_control.target_cm = -6.0f;
 471:application/ball_control.c ****         (void)BallControl_Update(BALL_REF_RAMP);
 472:application/ball_control.c ****     }
 473:application/ball_control.c **** 
 474:application/ball_control.c ****     ball_control_update_menu_position();
 475:application/ball_control.c **** }
 476:application/ball_control.c **** 
 477:application/ball_control.c **** /**
 478:application/ball_control.c ****  * @brief 任务2：折返运动与时效。
 479:application/ball_control.c ****  *
 480:application/ball_control.c ****  * 流程：
 481:application/ball_control.c ****  *   phase 0：从当前位置移动到 +6cm；
 482:application/ball_control.c ****  *   phase 1：折返移动到 -6cm；
 483:application/ball_control.c ****  *   phase 2：返回 0cm 并保持。
 484:application/ball_control.c ****  */
 485:application/ball_control.c **** static void ball_control_task_back_and_forth(void)
 486:application/ball_control.c **** {
 487:application/ball_control.c ****     BallControl_BeginTask(MENU_TASK_BACK_AND_FORTH);
 488:application/ball_control.c **** 
 489:application/ball_control.c ****     if (ball_control.task_phase == 0u) {
 490:application/ball_control.c ****         ball_control.target_cm = 6.0f;
 491:application/ball_control.c ****         if (BallControl_Update(BALL_REF_RAMP) != 0u) {
 492:application/ball_control.c ****             if (fabsf(ball_control.filtered_pos_cm - 6.0f) <= BALL_FOLD_ERROR_CM) {
 493:application/ball_control.c ****                 ball_control.task_phase = 1u;
 494:application/ball_control.c ****                 PIDResetIntegral(&ball_control.pid);
 495:application/ball_control.c ****             }
 496:application/ball_control.c ****         }
 497:application/ball_control.c ****     } else if (ball_control.task_phase == 1u) {
 498:application/ball_control.c ****         ball_control.target_cm = -6.0f;
 499:application/ball_control.c ****         if (BallControl_Update(BALL_REF_RAMP) != 0u) {
 500:application/ball_control.c ****             if (fabsf(ball_control.filtered_pos_cm + 6.0f) <= BALL_FOLD_ERROR_CM) {
 501:application/ball_control.c ****                 ball_control.task_phase = 2u;
 502:application/ball_control.c ****                 PIDResetIntegral(&ball_control.pid);
 503:application/ball_control.c ****             }
 504:application/ball_control.c ****         }
 505:application/ball_control.c ****     } else {
 506:application/ball_control.c ****         ball_control.target_cm = 0.0f;
 507:application/ball_control.c ****         (void)BallControl_Update(BALL_REF_RAMP);
 508:application/ball_control.c ****     }
 509:application/ball_control.c **** 
 510:application/ball_control.c ****     ball_control_update_menu_position();
 511:application/ball_control.c **** }
 512:application/ball_control.c **** 
 513:application/ball_control.c **** /**
 514:application/ball_control.c ****  * @brief 任务3：连续跟踪运动。
 515:application/ball_control.c ****  *
 516:application/ball_control.c ****  * 目标位置按周期 4 秒的正弦信号变化，幅值 ±8cm。
ARM GAS  C:\Users\LJH\AppData\Local\Temp\cc4ibJG6.s 			page 45


 517:application/ball_control.c ****  * 该任务保留速度和加速度前馈，用于后续单独调试。
 518:application/ball_control.c ****  */
 519:application/ball_control.c **** static void ball_control_task_continuous_track(void)
 520:application/ball_control.c **** {
 521:application/ball_control.c ****     BallControl_BeginTask(MENU_TASK_CONTINUOUS_TRACK);
 522:application/ball_control.c **** 
 523:application/ball_control.c ****     if (BallControl_Update(BALL_REF_SINE) != 0u) {
 524:application/ball_control.c ****         ball_control.task_elapsed_s += ball_control.last_dt_s;
 525:application/ball_control.c ****         if (ball_control.task_elapsed_s >= BALL_TRACK_PERIOD_S) {
 526:application/ball_control.c ****             ball_control.task_elapsed_s -= BALL_TRACK_PERIOD_S;
 527:application/ball_control.c ****         }
 528:application/ball_control.c ****     }
 529:application/ball_control.c **** 
 530:application/ball_control.c ****     ball_control_update_menu_position();
 531:application/ball_control.c **** }
 532:application/ball_control.c **** 
 533:application/ball_control.c **** /**
 534:application/ball_control.c ****  * @brief 任务4：抗干扰能力。
 535:application/ball_control.c ****  *
 536:application/ball_control.c ****  * 目标保持在 0cm，球被外力推走后由 PID 自动拉回中心。
 537:application/ball_control.c ****  */
 538:application/ball_control.c **** static void ball_control_task_anti_disturbance(void)
 539:application/ball_control.c **** {
 540:application/ball_control.c ****     BallControl_BeginTask(MENU_TASK_ANTI_DISTURBANCE);
 541:application/ball_control.c ****     ball_control.target_cm = 0.0f;
 542:application/ball_control.c ****     (void)BallControl_Update(BALL_REF_RAMP);
 543:application/ball_control.c ****     ball_control_update_menu_position();
 544:application/ball_control.c **** }
 545:application/ball_control.c **** 
 546:application/ball_control.c **** /**
