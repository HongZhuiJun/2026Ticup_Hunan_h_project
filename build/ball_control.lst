 625:application/ball_control.c **** /**
 626:application/ball_control.c ****  * @brief 任务1：定点稳定控制。
 627:application/ball_control.c ****  *
 628:application/ball_control.c ****  * 流程：
 629:application/ball_control.c ****  *   phase 0：移动到 +6cm，稳定 3 秒；
 630:application/ball_control.c ****  *   phase 1：移动到 -6cm，稳定 3 秒；
 631:application/ball_control.c ****  *   phase 2：保持在 -6cm。
 632:application/ball_control.c ****  */
 633:application/ball_control.c **** static void ball_control_task_stable_position(void)
 634:application/ball_control.c **** {
 635:application/ball_control.c ****     BallControl_BeginTask(MENU_TASK_STABLE_POSITION);
 636:application/ball_control.c **** 
 637:application/ball_control.c ****     if (ball_control.task_phase == 0u) {
 638:application/ball_control.c ****         ball_control.target_cm = 6.0f;
 639:application/ball_control.c ****         if (BallControl_Update(BALL_REF_RAMP) != 0u) {
 640:application/ball_control.c ****             if (BallControl_IsStable(BALL_STABLE_ERROR_CM) != 0u) {
 641:application/ball_control.c ****                 ball_control.stable_time_s += ball_control.last_dt_s;
 642:application/ball_control.c ****                 if (ball_control.stable_time_s >= BALL_STABLE_TIME_S) {
 643:application/ball_control.c ****                     ball_control.task_phase = 1u;
 644:application/ball_control.c ****                     ball_control.stable_time_s = 0.0f;
 645:application/ball_control.c ****                     PIDResetIntegral(&ball_control.pid);
 646:application/ball_control.c ****                 }
 647:application/ball_control.c ****             } else {
 648:application/ball_control.c ****                 ball_control.stable_time_s = 0.0f;
 649:application/ball_control.c ****             }
 650:application/ball_control.c ****         }
 651:application/ball_control.c ****     } else if (ball_control.task_phase == 1u) {
 652:application/ball_control.c ****         ball_control.target_cm = -6.0f;
 653:application/ball_control.c ****         if (BallControl_Update(BALL_REF_RAMP) != 0u) {
 654:application/ball_control.c ****             if (BallControl_IsStable(BALL_STABLE_ERROR_CM) != 0u) {
 655:application/ball_control.c ****                 ball_control.stable_time_s += ball_control.last_dt_s;
ARM GAS  C:\Users\LJH\AppData\Local\Temp\ccFYksKu.s 			page 50


 656:application/ball_control.c ****                 if (ball_control.stable_time_s >= BALL_STABLE_TIME_S) {
 657:application/ball_control.c ****                     ball_control.task_phase = 2u;
 658:application/ball_control.c ****                     ball_control.stable_time_s = 0.0f;
 659:application/ball_control.c ****                     PIDResetIntegral(&ball_control.pid);
 660:application/ball_control.c ****                 }
 661:application/ball_control.c ****             } else {
 662:application/ball_control.c ****                 ball_control.stable_time_s = 0.0f;
 663:application/ball_control.c ****             }
 664:application/ball_control.c ****         }
 665:application/ball_control.c ****     } else {
 666:application/ball_control.c ****         ball_control.target_cm = -6.0f;
 667:application/ball_control.c ****         (void)BallControl_Update(BALL_REF_RAMP);
 668:application/ball_control.c ****     }
 669:application/ball_control.c **** 
 670:application/ball_control.c ****     ball_control_update_menu_position();
 671:application/ball_control.c **** }
 672:application/ball_control.c **** 
 673:application/ball_control.c **** /**
 674:application/ball_control.c ****  * @brief 任务2：折返运动与时效。
 675:application/ball_control.c ****  *
 676:application/ball_control.c ****  * 流程：
 677:application/ball_control.c ****  *   phase 0：从当前位置移动到 +6cm；
 678:application/ball_control.c ****  *   phase 1：折返移动到 -6cm；
 679:application/ball_control.c ****  *   phase 2：返回 0cm 并保持。
 680:application/ball_control.c ****  */
 681:application/ball_control.c **** static void ball_control_task_back_and_forth(void)
 682:application/ball_control.c **** {
 683:application/ball_control.c ****     BallControl_BeginTask(MENU_TASK_BACK_AND_FORTH);
 684:application/ball_control.c **** 
 685:application/ball_control.c ****     if (ball_control.task_phase == 0u) {
 686:application/ball_control.c ****         ball_control.target_cm = 6.0f;
 687:application/ball_control.c ****         if (BallControl_Update(BALL_REF_RAMP) != 0u) {
 688:application/ball_control.c ****             if (fabsf(ball_control.filtered_pos_cm - 6.0f) <= BALL_FOLD_ERROR_CM) {
 689:application/ball_control.c ****                 ball_control.task_phase = 1u;
 690:application/ball_control.c ****                 PIDResetIntegral(&ball_control.pid);
 691:application/ball_control.c ****             }
 692:application/ball_control.c ****         }
 693:application/ball_control.c ****     } else if (ball_control.task_phase == 1u) {
 694:application/ball_control.c ****         ball_control.target_cm = -6.0f;
 695:application/ball_control.c ****         if (BallControl_Update(BALL_REF_RAMP) != 0u) {
 696:application/ball_control.c ****             if (fabsf(ball_control.filtered_pos_cm + 6.0f) <= BALL_FOLD_ERROR_CM) {
 697:application/ball_control.c ****                 ball_control.task_phase = 2u;
 698:application/ball_control.c ****                 PIDResetIntegral(&ball_control.pid);
 699:application/ball_control.c ****             }
 700:application/ball_control.c ****         }
 701:application/ball_control.c ****     } else {
 702:application/ball_control.c ****         ball_control.target_cm = 0.0f;
 703:application/ball_control.c ****         (void)BallControl_Update(BALL_REF_RAMP);
 704:application/ball_control.c ****     }
 705:application/ball_control.c **** 
 706:application/ball_control.c ****     ball_control_update_menu_position();
 707:application/ball_control.c **** }
 708:application/ball_control.c **** 
 709:application/ball_control.c **** /**
 710:application/ball_control.c ****  * @brief 任务3：连续跟踪运动。
 711:application/ball_control.c ****  *
 712:application/ball_control.c ****  * 目标位置按周期 4 秒的正弦信号变化，幅值 ±8cm。
ARM GAS  C:\Users\LJH\AppData\Local\Temp\ccFYksKu.s 			page 51


 713:application/ball_control.c ****  * 该任务保留速度和加速度前馈，用于后续单独调试。
 714:application/ball_control.c ****  */
 715:application/ball_control.c **** static void ball_control_task_continuous_track(void)
 716:application/ball_control.c **** {
 717:application/ball_control.c ****     BallControl_BeginTask(MENU_TASK_CONTINUOUS_TRACK);
 718:application/ball_control.c **** 
 719:application/ball_control.c ****     if (BallControl_Update(BALL_REF_SINE) != 0u) {
 720:application/ball_control.c ****         ball_control.task_elapsed_s += ball_control.last_dt_s;
 721:application/ball_control.c ****         if (ball_control.task_elapsed_s >= BALL_TRACK_PERIOD_S) {
 722:application/ball_control.c ****             ball_control.task_elapsed_s -= BALL_TRACK_PERIOD_S;
 723:application/ball_control.c ****         }
 724:application/ball_control.c ****     }
 725:application/ball_control.c **** 
 726:application/ball_control.c ****     ball_control_update_menu_position();
 727:application/ball_control.c **** }
 728:application/ball_control.c **** 
 729:application/ball_control.c **** /**
 730:application/ball_control.c ****  * @brief 任务4：抗干扰能力。
 731:application/ball_control.c ****  *
 732:application/ball_control.c ****  * 目标保持在 0cm，球被外力推走后由 PID 自动拉回中心。
