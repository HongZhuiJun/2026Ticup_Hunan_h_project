 734:application/ball_control.c **** static void ball_control_task_anti_disturbance(void)
 735:application/ball_control.c **** {
 736:application/ball_control.c ****     BallControl_BeginTask(MENU_TASK_ANTI_DISTURBANCE);
 737:application/ball_control.c ****     ball_control.target_cm = 0.0f;
 738:application/ball_control.c ****     (void)BallControl_Update(BALL_REF_RAMP);
 739:application/ball_control.c ****     ball_control_update_menu_position();
 740:application/ball_control.c **** }
