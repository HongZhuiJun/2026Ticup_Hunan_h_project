 458:application/ball_control.c ****     pid_out_deg = PIDCalculate(&ball_control.pid,
 459:application/ball_control.c ****                                ball_control.ref_pos_cm,
 460:application/ball_control.c ****                                ball_control.filtered_pos_cm);
 461:application/ball_control.c **** 
 462:application/ball_control.c ****     /*
 463:application/ball_control.c ****      * 任务1/2/4/5 只使用 PID 反馈，不再叠加速度和加速度前馈。
 464:application/ball_control.c ****      * 任务3保留这两项，用于后续正弦跟踪调试。
 465:application/ball_control.c ****      */
 466:application/ball_control.c ****     velocity_trim_deg = 0.0f;
 467:application/ball_control.c ****     accel_ff_deg = 0.0f;
 468:application/ball_control.c ****     if (ball_control.feedforward_enabled != 0u) {
 469:application/ball_control.c ****         /*
 470:application/ball_control.c ****          * 速度前馈用独立的 vel_ff_gain，不再借用 kd。
 471:application/ball_control.c ****          * 以前两者共用一个系数，调阻尼时会把前馈一起改掉，没法分开整�
 472:application/ball_control.c ****          */
 473:application/ball_control.c ****         velocity_trim_deg = config->vel_ff_gain * ball_control.ref_vel_cmps;
 474:application/ball_control.c ****         /*
 475:application/ball_control.c ****          * 速度前馈的来历：完整微分项 Kd·(de/dt) = Kd·ṙ - Kd·ẋ（其中 e = r -
 476:application/ball_control.c ****          * PID 只对测量值求导，内部算的是 -Kd·ẋ，丢掉了 Kd·ṙ，由上面这�
 477:application/ball_control.c ****          */
 478:application/ball_control.c ****         accel_ff_deg = config->ff_accel_gain * ball_control.ref_acc_cmps2;
 479:application/ball_control.c ****     }
 480:application/ball_control.c **** 
 481:application/ball_control.c ****     tube_angle_deg = pid_out_deg + velocity_trim_deg + accel_ff_deg;
 482:application/ball_control.c ****     BallControl_ApplyTubeAngle(tube_angle_deg);
 483:application/ball_control.c **** }
