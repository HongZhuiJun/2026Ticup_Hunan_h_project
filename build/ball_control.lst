 429:application/ball_control.c **** /**
 430:application/ball_control.c ****  * @brief 执行一次位置闭环控制。
 431:application/ball_control.c ****  *
 432:application/ball_control.c ****  * 读取参考位置和滤波后的球位置，计算 PID 输出，再根据任务类型决定是�
 433:application/ball_control.c ****  *   - 速度补偿；
 434:application/ball_control.c ****  *   - 加速度前馈。
 435:application/ball_control.c ****  *
 436:application/ball_control.c ****  * 任务1/2/4/5 只使用 PID；任务3保留前馈。
 437:application/ball_control.c ****  */
 438:application/ball_control.c **** static void BallControl_UpdateControlLoop(void)
 439:application/ball_control.c **** {
 440:application/ball_control.c ****     const BallTaskConfig_t *config = ball_control.config;
 441:application/ball_control.c ****     float error_cm = ball_control.ref_pos_cm - ball_control.filtered_pos_cm;
 442:application/ball_control.c ****     float pid_out_deg;
 443:application/ball_control.c ****     float velocity_trim_deg;
 444:application/ball_control.c ****     float accel_ff_deg;
 445:application/ball_control.c ****     float tube_angle_deg;
 446:application/ball_control.c **** 
 447:application/ball_control.c ****     if (config == NULL) {
 448:application/ball_control.c ****         return;
 449:application/ball_control.c ****     }
 450:application/ball_control.c **** 
 451:application/ball_control.c ****     /* 大误差或高速阶段不积分，避免积分饱和。 */
 452:application/ball_control.c ****     if ((fabsf(error_cm) > config->integral_zone_cm) ||
 453:application/ball_control.c ****         (fabsf(ball_control.ball_vel_cmps) > config->integral_vel_cmps)) {
 454:application/ball_control.c ****         PIDResetIntegral(&ball_control.pid);
 455:application/ball_control.c ****     }
