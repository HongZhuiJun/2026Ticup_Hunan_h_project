   1:application/ball_control.c **** /**
   2:application/ball_control.c ****  * @file ball_control.c
   3:application/ball_control.c ****  * @brief Application 层：钢球平衡控制的 5 个赛题任务。
   4:application/ball_control.c ****  *
   5:application/ball_control.c ****  * 与菜单的分工（规范 §2.2 的 Application -> Module 单向依赖）：
   6:application/ball_control.c ****  *   - 菜单（Module）只管显示和按键，不知道任何控制算法；
   7:application/ball_control.c ****  *   - 本模块在 BallControlInit() 里把自己的任务函数注册给菜单，
   8:application/ball_control.c ****  *     菜单的三级页面每轮通过函数指针调用一次被选中的那个；
   9:application/ball_control.c ****  *   - 任务页要显示的小球位置，用 OLEDMenu_SetBallPositionCm() 推给菜单，
  10:application/ball_control.c ****  *     不要在任务函数里直接调 OLED 画图（菜单每轮会清屏重绘）。
  11:application/ball_control.c ****  *
  12:application/ball_control.c ****  * 每个任务函数都必须是「跑一轮就返回」的写法：
  13:application/ball_control.c ****  *   不能有死循环、长延时或阻塞等待，否则菜单的按键扫描会失灵、
  14:application/ball_control.c ****  *   KEY3 回不到二级菜单。
  15:application/ball_control.c ****  */
  16:application/ball_control.c **** #include "ball_control.h"
  17:application/ball_control.c **** #include "oled_menu.h"
  18:application/ball_control.c **** 
  19:application/ball_control.c **** /**
  20:application/ball_control.c ****  * @brief 把当前小球位置推给菜单显示。
  21:application/ball_control.c ****  *
  22:application/ball_control.c ****  * 位置来自 K230 视觉模块。k230_to_stm32 目前对外只有初始化接口，
  23:application/ball_control.c ****  * 还没有给 Application 用的取值接口，补上之后在这里接：
  24:application/ball_control.c ****  *     float pos_cm;
  25:application/ball_control.c ****  *     if (k230_to_stm32_GetPosCm(&pos_cm) != 0u) {
  26:application/ball_control.c ****  *         OLEDMenu_SetBallPositionCm((int8_t)pos_cm);   // 位置无效时保持上次显示
  27:application/ball_control.c ****  *     }
  28:application/ball_control.c ****  * 注意位置无效（钢球丢失 / 视觉离线）时不要推 0，否则屏幕上会假装球�
  29:application/ball_control.c ****  */
  30:application/ball_control.c **** static void ball_control_update_menu_position(void)
  31:application/ball_control.c **** {
  32:application/ball_control.c ****     /* TODO: 读视觉位置并推给菜单 */
  33:application/ball_control.c **** }
