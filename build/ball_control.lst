 246:application/ball_control.c **** /**
 247:application/ball_control.c ****  * @brief 执行一次位置闭环控制。
 248:application/ball_control.c ****  *
 249:application/ball_control.c ****  * 读取参考位置和滤波后的球位置，计算 PID 输出，再根据任务类型决定是�
 250:application/ball_control.c ****  *   - 速度补偿；
 251:application/ball_control.c ****  *   - 加速度前馈。
 252:application/ball_control.c ****  *
 253:application/ball_control.c ****  * 任务1/2/4/5 只使用 PID；任务3保留前馈。
 254:application/ball_control.c ****  */
 255:application/ball_control.c **** static void BallControl_UpdateControlLoop(void)
 256:application/ball_control.c **** {
 257:application/ball_control.c ****     float error_cm = ball_control.ref_pos_cm - ball_control.filtered_pos_cm;
 258:application/ball_control.c ****     float pid_out_deg;
 259:application/ball_control.c ****     float velocity_trim_deg;
 260:application/ball_control.c ****     float accel_ff_deg;
 261:application/ball_control.c ****     float tube_angle_deg;
 262:application/ball_control.c **** 
 263:application/ball_control.c ****     /* 大误差或高速阶段不积分，避免积分饱和。 */
 264:application/ball_control.c ****     if ((fabsf(error_cm) > BALL_PID_INTEGRAL_ZONE_CM) ||
 265:application/ball_control.c ****         (fabsf(ball_control.ball_vel_cmps) > BALL_PID_INTEGRAL_VEL_CMPS)) {
 266:application/ball_control.c ****         PIDResetIntegral(&ball_control.pid);
 267:application/ball_control.c ****     }
 268:application/ball_control.c **** 
 269:application/ball_control.c ****     ball_control.pid.dt_s = ball_control.last_dt_s;
 270:application/ball_control.c ****     pid_out_deg = PIDCalculate(&ball_control.pid,
 271:application/ball_control.c ****                                ball_control.ref_pos_cm,
 272:application/ball_control.c ****                                ball_control.filtered_pos_cm);
 273:application/ball_control.c **** 
 274:application/ball_control.c ****     /*
 275:application/ball_control.c ****      * 任务1/2/4/5 只使用 PID 反馈，不再叠加速度和加速度前馈。
 276:application/ball_control.c ****      * 任务3保留这两项，用于后续正弦跟踪调试。
 277:application/ball_control.c ****      */
 278:application/ball_control.c ****     velocity_trim_deg = 0.0f;
 279:application/ball_control.c ****     accel_ff_deg = 0.0f;
 280:application/ball_control.c ****     if (ball_control.feedforward_enabled != 0u) {
 281:application/ball_control.c ****         velocity_trim_deg = BALL_PID_KD * ball_control.ref_vel_cmps;
 282:application/ball_control.c ****         accel_ff_deg = BALL_FF_ACCEL_DEG_PER_CMPS2 * ball_control.ref_acc_cmps2;
 283:application/ball_control.c ****     }
 284:application/ball_control.c **** 
 285:application/ball_control.c ****     tube_angle_deg = pid_out_deg + velocity_trim_deg + accel_ff_deg;
 286:application/ball_control.c ****     BallControl_ApplyTubeAngle(tube_angle_deg);
 287:application/ball_control.c **** }
 288:application/ball_control.c **** 
